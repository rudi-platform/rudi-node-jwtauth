{
  "name": "rudi-api-client",
  "version": "1.0.0",
  "description": "JWT creation and files encryption",
  "main": "./_main.js",
  "scripts": {
    "prestart": "npm install",
    "start": "node ./_main.js",
    "extstart": "nodemon -e js,ini --exec \"npm run rudiapp\"",
    "rudiapp": "npm install && node ./_main.js",
    "devstart": "./node_modules/nodemon/bin/nodemon.js ./_main.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "cleanup": "rm -fR ./node_modules ./package-lock.json ./yarn.lock"
  },
