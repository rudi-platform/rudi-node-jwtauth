    "axios": "^0.27.2",
    "date-and-time": "^2.4.0",
    "fastify": "^4.1.0",
    "ini": "^3.0.0",
    "lodash": "^4.17.21",
    "nodemon": "^2.0.18",
    "sshpk": "^1.17.0",
    "uuid": "^8.3.2",
    "winston": "^3.8.0",
    "winston-daily-rotate-file": "^4.7.1"
  }
}
